            <button onclick="appState.createNewNote()" class="px-8 py-4 bg-black hover:bg-zinc-800 text-white font-medium rounded-full transition-all shadow-[0_8px_20px_rgba(0,0,0,0.15)] active:scale-95 flex items-center gap-3 mx-auto">
