        <!-- H?p Modal bo góc siêu tròn -->
        <div class="bg-white/90 backdrop-blur-2xl p-8 rounded-[2.5rem] shadow-2xl max-w-sm w-full border border-white transform scale-90 transition-transform duration-300" id="confirm-modal-box">
            
            <div class="w-16 h-16 bg-red-50 rounded-[1.5rem] flex items-center justify-center mb-6 mx-auto border border-red-100">
