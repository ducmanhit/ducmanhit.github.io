            <!-- Nút xóa phong cách Danger -->
            <button onclick="appState.deleteCurrentNote()" class="w-12 h-12 bg-white/50 hover:bg-red-50 text-zinc-400 hover:text-red-500 rounded-full flex items-center justify-center transition-all backdrop-blur-md shadow-sm border border-white/60 hover:border-red-100 active:scale-90 group" title="Xóa ghi chú">
