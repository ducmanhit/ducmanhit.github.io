    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'modern-glass-notes';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : null;

        let db, auth, user;
        let unsubscribeSnapshot = null;

        window.appState = {
            notebookId: null,
            notes: [],
            activeNoteId: null,
            isSaving: false,
            saveTimeout: null,

            async init() {
                if (!firebaseConfig) {
                    this.showToast("L?i: Thi?u c?u hình Database", false);
                    return;
                }
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                try {
                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        const credential = await signInWithCustomToken(auth, __initial_auth_token);
                        user = credential.user;
                    } else {
                        const credential = await signInAnonymously(auth);
                        user = credential.user;
                    }
                    this.setupURLId();
                    this.listenToData();
                    this.setupEventListeners();
                } catch (error) {
                    this.showToast("L?i k?t n?i", false);
                }
            },

            /* L?y ho?c t?o mã thi?t b? (ID) */
            setupURLId() {
                const urlParams = new URLSearchParams(window.location.search);
                let id = urlParams.get('id');
                
                if (!id) {
                    try { id = localStorage.getItem('mobbin_note_id'); } catch(e) {}
                }
                if (!id) {
                    id = crypto.randomUUID().replace(/-/g, '').substring(0, 16);
                }
                
                try { localStorage.setItem('mobbin_note_id', id); } catch(e) {}

                try {
                    const currentUrl = new URL(window.location.href);
                    currentUrl.searchParams.set('id', id);
                    window.history.replaceState({path: currentUrl.href}, '', currentUrl.href);
                } catch (error) {
                    // Ch?y trong iFrame preview
                }
                this.notebookId = id;
                document.getElementById('workspace-id').textContent = 'ID: ' + id.substring(0,8) + '...';
            },

            listenToData() {
                if (!user || !this.notebookId) return;
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'notebooks', this.notebookId);
                
                unsubscribeSnapshot = onSnapshot(docRef, (docSnap) => {
                    if (docSnap.exists()) {
                        this.notes = docSnap.data().notes || [];
                    } else {
                        this.notes = [];
                    }
                    
                    const loader = document.getElementById('loading');
                    loader.style.opacity = '0';
                    setTimeout(() => loader.classList.add('hidden'), 700);

                    this.renderGrid();
                    
                    if(this.activeNoteId && !this.isSaving) {
                         const current = this.notes.find(n => n.id === this.activeNoteId);
                         if(current) {
                             const tInput = document.getElementById('note-title');
                             const bInput = document.getElementById('note-body');
                             if(document.activeElement !== tInput) tInput.value = current.title;
                             if(document.activeElement !== bInput) bInput.value = current.body;
                         }
                    }
                }, (error) => {
                    this.showToast("M?t k?t n?i d?ng b?", false);
                });
            },

            async saveToCloud() {
                if (!user || !this.notebookId) return;
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'notebooks', this.notebookId);
                this.updateStatusUI('syncing', 'Ðang luu...');
                
                try {
                    if(this.activeNoteId) {
                        const note = this.notes.find(n => n.id === this.activeNoteId);
                        if(note) note.updatedAt = Date.now();
                    }
                    await setDoc(docRef, { notes: this.notes, updatedAt: Date.now() });
                    this.updateStatusUI('synced', 'Ðã luu');
                    if(this.activeNoteId) this.updateMetaInfo(this.activeNoteId);
                } catch (error) {
                    this.updateStatusUI('error', 'L?i luu');
                } finally {
                    this.isSaving = false;
                }
            },

            debouncedSave() {
                this.isSaving = true;
                this.updateStatusUI('syncing', 'Ðang so?n...');
                clearTimeout(this.saveTimeout);
                this.saveTimeout = setTimeout(() => this.saveToCloud(), 800);
            },

            updateStatusUI(state, text) {
                const navText = document.getElementById('nav-status');
                const navDot = document.getElementById('nav-status-dot');
                const edText = document.getElementById('editor-status');
                const edDot = document.getElementById('editor-status-dot');

                if(navText) navText.textContent = text;
                if(edText) edText.textContent = text;
                [navDot, edDot].forEach(el => {
                    if(el) el.className = `status-dot status-${state}`;
                });
            },

            formatDate(timestamp) {
                const date = new Date(timestamp);
                const today = new Date();
                const isToday = date.getDate() === today.getDate() && date.getMonth() === today.getMonth() && date.getFullYear() === today.getFullYear();
                const time = date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                if (isToday) return `Hôm nay, ${time}`;
                return `${date.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' })}, ${time}`;
            },

            renderGrid() {
                const container = document.getElementById('notes-container');
                const emptyState = document.getElementById('empty-state');
                
                if (this.notes.length === 0) {
                    container.innerHTML = '';
                    emptyState.classList.replace('hidden', 'flex');
                    return;
                }
                emptyState.classList.replace('flex', 'hidden');
                
                const sorted = [...this.notes].sort((a, b) => b.updatedAt - a.updatedAt);
                
                container.innerHTML = sorted.map(note => {
                    let displayTitle = note.title.trim();
                    let displayBody = note.body.trim();
                    
                    if (!displayTitle) {
                        if (displayBody) {
                            const firstLine = displayBody.split('\n')[0];
                            displayTitle = firstLine.length > 35 ? firstLine.substring(0, 35) + '...' : firstLine;
                            displayBody = displayBody.substring(firstLine.length).trim();
                        } else {
                            displayTitle = 'Ghi chú tr?ng';
                        }
                    }

                    return `
                        <div onclick="appState.openEditor('${note.id}')" 
                             class="glass-card rounded-[1.5rem] p-6 cursor-pointer group flex flex-col h-[280px] relative overflow-hidden spring-up">
                            
                            <h3 class="font-bold text-xl mb-3 text-zinc-900 line-clamp-2 leading-snug">
                                ${displayTitle}
                            </h3>
                            
                            <p class="text-zinc-500 text-sm leading-relaxed line-clamp-4 flex-1 whitespace-pre-wrap font-medium opacity-90">
                                ${displayBody || '<span class="italic font-normal opacity-50">Không có n?i dung...</span>'}
                            </p>
                            
                            <div class="mt-4 pt-4 border-t border-zinc-200/50 flex items-center justify-between text-[11px] text-zinc-400 font-bold uppercase tracking-wide">
                                <span>${this.formatDate(note.updatedAt)}</span>
                                <div class="w-8 h-8 rounded-full bg-zinc-100 flex items-center justify-center group-hover:bg-black group-hover:text-white transition-all duration-300 transform group-hover:scale-110 group-hover:-rotate-12 shadow-sm">
                                    <i class="ph-bold ph-arrow-right"></i>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
            },

            createNewNote() {
                const newId = crypto.randomUUID();
                this.notes.unshift({ id: newId, title: '', body: '', createdAt: Date.now(), updatedAt: Date.now() });
                this.saveToCloud(); 
                this.openEditor(newId);
            },

            openEditor(id) {
                const note = this.notes.find(n => n.id === id);
                if (!note) return;

                this.activeNoteId = id;
                document.getElementById('note-title').value = note.title;
                document.getElementById('note-body').value = note.body;
                this.updateMetaInfo(id);

                const editor = document.getElementById('view-editor');
                const grid = document.getElementById('view-grid');
                const nav = document.getElementById('main-nav');
                
                editor.classList.remove('hidden');
                // S? d?ng requestAnimationFrame d? animation mu?t hon
                requestAnimationFrame(() => {
                    editor.classList.remove('opacity-0');
                    grid.style.opacity = '0';
                    grid.style.transform = 'scale(0.95)';
                    nav.style.transform = 'translateY(-150%)';
                });

                const tx = document.getElementById('note-body');
                tx.style.height = 'auto';
                tx.style.height = (tx.scrollHeight) + 'px';

                if(!note.title && !note.body) {
                    setTimeout(() => document.getElementById('note-title').focus(), 400);
                }
            },

            closeEditor() {
                this.activeNoteId = null;
                const editor = document.getElementById('view-editor');
                const grid = document.getElementById('view-grid');
                const nav = document.getElementById('main-nav');
                
                editor.classList.add('opacity-0');
                grid.style.opacity = '1';
                grid.style.transform = 'scale(1)';
                nav.style.transform = 'translateY(0)';
                
                setTimeout(() => editor.classList.add('hidden'), 500);
                this.renderGrid();
            },

            updateMetaInfo(id) {
                const note = this.notes.find(n => n.id === id);
                if(!note) return;
                const metaDiv = document.getElementById('note-meta-info');
                metaDiv.classList.remove('hidden');
                metaDiv.classList.add('flex');
                const c = new Date(note.createdAt).toLocaleDateString('vi-VN', {day:'2-digit', month:'2-digit', year:'numeric'});
                metaDiv.innerHTML = `
                    <span class="flex items-center gap-2"><i class="ph-duotone ph-calendar-plus text-lg"></i> T?o: ${c}</span>
                    <span class="flex items-center gap-2"><i class="ph-duotone ph-clock-counter-clockwise text-lg"></i> Luu: ${this.formatDate(note.updatedAt)}</span>
                `;
            },

            deleteCurrentNote() {
                const modal = document.getElementById('confirm-modal');
                const box = document.getElementById('confirm-modal-box');
                modal.classList.replace('hidden', 'flex');
                requestAnimationFrame(() => {
                    modal.classList.remove('opacity-0');
                    box.classList.remove('scale-90');
                });
                
                document.getElementById('btn-confirm-delete').onclick = () => {
                    this.notes = this.notes.filter(n => n.id !== this.activeNoteId);
                    this.saveToCloud();
                    this.closeModal();
                    this.closeEditor();
                    this.showToast("Ðã xóa vinh vi?n ghi chú");
                };
            },

            closeModal() {
                const modal = document.getElementById('confirm-modal');
                const box = document.getElementById('confirm-modal-box');
                modal.classList.add('opacity-0');
                box.classList.add('scale-90');
                setTimeout(() => modal.classList.replace('flex', 'hidden'), 300);
            },

            showToast(msg, isSuccess = true) {
                const toast = document.getElementById('toast');
                const icon = document.getElementById('toast-icon');
                const bg = document.getElementById('toast-icon-bg');
                
                document.getElementById('toast-msg').textContent = msg;
                
                if(isSuccess) {
                    icon.className = 'ph-bold ph-check text-emerald-400';
                    bg.className = 'w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center';
                } else {
                    icon.className = 'ph-bold ph-warning text-red-400';
                    bg.className = 'w-6 h-6 rounded-full bg-red-500/20 flex items-center justify-center';
                }

                // Animation d?ng tru?t t? trên xu?ng (Dynamic Island)
                toast.classList.remove('-translate-y-[150%]');
                toast.classList.add('translate-y-0');
                
                setTimeout(() => {
                    toast.classList.add('-translate-y-[150%]');
                    toast.classList.remove('translate-y-0');
                }, 3500);
            },

            setupEventListeners() {
                const btnMenu = document.getElementById('btn-menu');
                const dropdown = document.getElementById('dropdown-menu');
                
                btnMenu.addEventListener('click', (e) => {
                    e.stopPropagation();
                    dropdown.classList.toggle('show');
                });

                document.addEventListener('click', (e) => {
                    if (!dropdown.contains(e.target) && !btnMenu.contains(e.target)) {
                        dropdown.classList.remove('show');
                    }
                });

                document.getElementById('btn-copy-link').addEventListener('click', () => {
                    dropdown.classList.remove('show');
                    let finalUrl = window.location.href;
                    try {
                        const u = new URL(window.location.href);
                        u.searchParams.set('id', this.notebookId);
                        finalUrl = u.href;
                        if (u.protocol === 'blob:') throw new Error('Preview mode');
                    } catch(e) {
                        // Fallback URL construct n?u ? ch? d? Preview iframe
                        finalUrl = window.location.origin + window.location.pathname + '?id=' + this.notebookId;
                    }

                    const textArea = document.createElement("textarea");
                    textArea.value = finalUrl;
                    document.body.appendChild(textArea);
                    textArea.select();
                    try {
                        document.execCommand('copy');
                        this.showToast("Ðã copy Link thành công!");
                    } catch (err) {
                        this.showToast("L?i khi copy", false);
                    }
                    document.body.removeChild(textArea);
                });

                const handleInput = (e) => {
                    if (!this.activeNoteId) return;
                    const note = this.notes.find(n => n.id === this.activeNoteId);
                    if (note) {
                        if (e.target.id === 'note-title') note.title = e.target.value;
                        if (e.target.id === 'note-body') note.body = e.target.value;
                        note.updatedAt = Date.now(); 
                        this.debouncedSave();
                        this.updateMetaInfo(this.activeNoteId);
                    }
                };

                document.getElementById('note-title').addEventListener('input', handleInput);
                document.getElementById('note-body').addEventListener('input', handleInput);
                
                const tx = document.getElementById('note-body');
                tx.addEventListener("input", function() {
                    this.style.height = 'auto';
                    this.style.height = (this.scrollHeight) + 'px';
                }, false);
            }
        };

        window.addEventListener('DOMContentLoaded', () => appState.init());
    </script>
</body>
</html>